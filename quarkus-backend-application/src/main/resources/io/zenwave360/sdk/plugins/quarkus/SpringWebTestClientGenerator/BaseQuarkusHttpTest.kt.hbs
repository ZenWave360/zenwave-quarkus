package {{baseTestClassPackage}}

import io.quarkus.test.junit.QuarkusTest
import java.net.URI
import java.net.http.HttpClient
{{#if transactional}}
import jakarta.transaction.Transactional
{{/if}}

@QuarkusTest
{{#if transactional}}
@Transactional
{{/if}}
abstract class BaseQuarkusHttpTest {

    protected val httpClient: HttpClient = HttpClient.newHttpClient()

    protected fun resourceUri(endpoint: URI, path: String): URI {
        val base = endpoint.toString().trimEnd('/')
        val suffix = if (path.startsWith("/")) path else "/$path"
        return URI.create(base + suffix)
    }
}
