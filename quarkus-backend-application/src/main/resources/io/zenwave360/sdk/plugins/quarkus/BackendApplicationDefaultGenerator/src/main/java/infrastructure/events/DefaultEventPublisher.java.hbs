package {{layout.infrastructureEventsPackage}};

import {{layout.domainEventsPackage}}.*;
import {{layout.outboundEventsPackage}}.EventPublisher;
import jakarta.enterprise.context.ApplicationScoped;
import jakarta.enterprise.event.Event;
import jakarta.inject.Inject;

@ApplicationScoped
{{annotate "infrastructure.event-publisher"}}
public class DefaultEventPublisher implements EventPublisher {

{{#each events as |event|}}
    private final Event<{{event.className}}> {{asInstanceName event.className}};
{{/each}}

    @Inject
    public DefaultEventPublisher(
{{#each events as |event|}}
        Event<{{event.className}}> {{asInstanceName event.className}}{{#unless @last}},{{/unless}}
{{/each}}
    ) {
{{#each events as |event|}}
        this.{{asInstanceName event.className}} = {{asInstanceName event.className}};
{{/each}}
    }

{{#each events as |event|}}
    @Override
    public void on{{event.className}}({{event.className}} event) {
        {{asInstanceName event.className}}.fire(event);
    }
{{/each}}
}
