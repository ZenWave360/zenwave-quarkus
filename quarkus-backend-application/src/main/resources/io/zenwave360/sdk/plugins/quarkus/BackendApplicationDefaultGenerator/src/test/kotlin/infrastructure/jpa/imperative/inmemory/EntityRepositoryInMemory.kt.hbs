package {{layout.infrastructureRepositoryPackage}}.inmemory

import {{layout.entitiesPackage}}.*
import {{layout.outboundRepositoryPackage}}.{{entity.className}}Repository

class {{entity.className}}RepositoryInMemory :
    InMemoryJpaRepository<{{entity.className}}, {{idJavaType}}>(),
    {{entity.className}}Repository {

{{~#if (naturalIdFields entity)}}
    override {{{naturalIdsRepoMethodSignature entity}}} {
        return entities.values.firstOrNull { entity ->
            {{#joinWithTemplate (naturalIdFields entity) delimiter=' && '}}entity.{{name}} == {{name}}{{/joinWithTemplate}}
        }
    }
{{~/if}}

    private var sequence: Long = 1

    override fun idOf(entity: {{entity.className}}): {{idJavaType}}? = entity.id

    override fun setId(entity: {{entity.className}}, id: {{idJavaType}}) {
        entity.id = id
    }

    override fun newId(): {{idJavaType}} {
        val next = sequence++
        {{#if (eq idJavaType "String")}}
        return next.toString()
        {{else if (eq idJavaType "Integer")}}
        return next.toInt()
        {{else}}
        return next
        {{/if}}
    }
}
