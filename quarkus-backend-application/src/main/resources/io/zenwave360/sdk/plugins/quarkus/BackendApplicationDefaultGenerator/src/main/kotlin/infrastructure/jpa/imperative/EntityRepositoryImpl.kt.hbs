package {{layout.infrastructureRepositoryPackage}}

import {{layout.entitiesPackage}}.*
import {{layout.outboundRepositoryPackage}}.{{entity.className}}Repository
import jakarta.enterprise.context.ApplicationScoped
import jakarta.persistence.EntityManager

/**
 * EntityManager implementation of the {{entity.className}} repository port.
 */
@ApplicationScoped
open class {{entity.className}}RepositoryImpl(
    private val entityManager: EntityManager
) : {{entity.className}}Repository {

    override fun save(entity: {{entity.className}}): {{entity.className}} {
        return if (entity.id == null) {
            entityManager.persist(entity)
            entity
        } else {
            entityManager.merge(entity)
        }
    }

    override fun saveAll(entities: List<{{entity.className}}>): List<{{entity.className}}> {
        return entities.map { save(it) }
    }

    override fun findById(id: {{idJavaType}}): {{entity.className}}? {
        return entityManager.find({{entity.className}}::class.java, id)
    }

    override fun deleteById(id: {{idJavaType}}) {
        findById(id)?.let { delete(it) }
    }

    override fun delete(entity: {{entity.className}}) {
        val managed = if (entityManager.contains(entity)) entity else entityManager.merge(entity)
        entityManager.remove(managed)
    }

    override fun findAll(): List<{{entity.className}}> {
        return entityManager.createQuery("from {{entity.className}}", {{entity.className}}::class.java).resultList
    }

    override fun findAll(page: Int, size: Int): List<{{entity.className}}> {
        return entityManager.createQuery("from {{entity.className}}", {{entity.className}}::class.java)
            .setFirstResult(page * size)
            .setMaxResults(size)
            .resultList
    }
}
