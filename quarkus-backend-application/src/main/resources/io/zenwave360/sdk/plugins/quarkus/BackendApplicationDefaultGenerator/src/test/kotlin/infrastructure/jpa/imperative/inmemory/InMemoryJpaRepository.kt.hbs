package {{layout.infrastructureRepositoryPackage}}.inmemory

/**
 * In-memory store used by generated repository fakes.
 */
abstract class InMemoryJpaRepository<T, ID> {

    protected val entities = linkedMapOf<ID, T>()

    open fun save(entity: T): T {
        val id = idOf(entity) ?: newId().also { setId(entity, it) }
        entities[id] = entity
        return entity
    }

    fun saveAll(values: List<T>): List<T> = values.map { save(it) }

    fun findById(id: ID): T? = entities[id]

    fun deleteById(id: ID) {
        entities.remove(id)
    }

    fun delete(entity: T) {
        idOf(entity)?.let { entities.remove(it) }
    }

    fun findAll(): List<T> = entities.values.toList()

    fun findAll(page: Int, size: Int): List<T> = findAll().drop(page * size).take(size)

    fun deleteAll() {
        entities.clear()
    }

    protected abstract fun idOf(entity: T): ID?

    protected abstract fun setId(entity: T, id: ID)

    protected abstract fun newId(): ID
}
