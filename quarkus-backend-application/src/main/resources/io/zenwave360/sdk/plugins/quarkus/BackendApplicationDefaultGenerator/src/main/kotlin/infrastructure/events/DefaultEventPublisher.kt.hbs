package {{layout.infrastructureEventsPackage}}

import {{layout.domainEventsPackage}}.*
import {{layout.outboundEventsPackage}}.EventPublisher
import jakarta.enterprise.context.ApplicationScoped
import jakarta.enterprise.event.Event

@ApplicationScoped
{{annotate "infrastructure.event-publisher"}}
open class DefaultEventPublisher(
{{#each events as |event|}}
    private val {{asInstanceName event.className}}: Event<{{event.className}}>{{#unless @last}},{{/unless}}
{{/each}}
) : EventPublisher {

{{#each events as |event|}}
    override fun on{{event.className}}(event: {{event.className}}) {
        {{asInstanceName event.className}}.fire(event)
    }
{{/each}}
}
