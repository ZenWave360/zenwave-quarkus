package {{layout.outboundRepositoryPackage}}
{{~assign 'aggregate' (findEntityAggregate entity.name)}}

import {{layout.entitiesPackage}}.*

/**
 * Outbound repository port for the {{entity.className}} entity.
 */
interface {{entity.className}}Repository {

{{~#if aggregate}}
    fun find{{aggregate}}ById(id: {{idJavaType}}): {{aggregate}}? {
      return findById(id)?.let { {{aggregate}}(it) }
    }
{{~/if}}

    fun save(entity: {{entity.className}}): {{entity.className}}

    fun saveAll(entities: List<{{entity.className}}>): List<{{entity.className}}>

    fun findById(id: {{idJavaType}}): {{entity.className}}?

    fun deleteById(id: {{idJavaType}})

    fun delete(entity: {{entity.className}})

    fun findAll(): List<{{entity.className}}>

    fun findAll(page: Int, size: Int): List<{{entity.className}}>

{{~#if (naturalIdFields entity)}}{{{naturalIdsRepoMethodSignature entity}}}{{/if}}
}
