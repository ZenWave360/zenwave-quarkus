{{~#if (hasRuntimeHeaders operations)}}
    protected void processRuntimeHeaders(Object payload, java.util.Map<String, Object> headers,
            java.util.Map<String, String> runtimeHeaders) {
        if (runtimeHeaders == null || runtimeHeaders.isEmpty() || headers == null) {
            return;
        }
        com.fasterxml.jackson.databind.JsonNode tree = null;
        for (java.util.Map.Entry<String, String> runtimeHeader : runtimeHeaders.entrySet()) {
            String location = runtimeHeader.getValue().replace("$message.payload", "").trim();
            if (location.startsWith("#{") && location.endsWith("}")) {
                log.warn("Spring SpEL runtime header is not evaluated: {}", location);
                continue;
            }
            if (location.startsWith("$")) {
                var suppliedValue = getSuppliedValue(location.substring(1));
                if (suppliedValue != null) {
                    headers.put(runtimeHeader.getKey(), suppliedValue.orElse(null));
                }
                continue;
            }
            if (location.startsWith("#/") && !headers.containsKey(runtimeHeader.getKey())) {
                // JSON pointer over the serialized payload: no bean reflection
                if (tree == null) {
                    tree = objectMapper.valueToTree(payload);
                }
                var node = tree.at(location.substring(1));
                if (!node.isMissingNode() && !node.isNull()) {
                    headers.put(runtimeHeader.getKey(), node.isValueNode() ? node.asText() : node.toString());
                }
            }
        }
    }

    /** {@code @Named} {@code Supplier} bean for {@code $beanName} runtime headers. */
    protected java.util.Optional<Object> getSuppliedValue(String supplierBeanName) {
        if (beans == null) {
            return null;
        }
        var selected = beans.select(jakarta.enterprise.inject.literal.NamedLiteral.of(supplierBeanName));
        if (selected.isResolvable() && selected.get() instanceof java.util.function.Supplier<?> bean) {
            return java.util.Optional.ofNullable(bean.get());
        }
        log.warn("No @Named Supplier bean: {}", supplierBeanName);
        return null;
    }
{{~/if}}
