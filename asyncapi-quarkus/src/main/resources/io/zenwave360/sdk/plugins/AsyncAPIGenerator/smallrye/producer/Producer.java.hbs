    /** JSON text; {@code null} payload is sent as a Kafka tombstone. */
    protected String toJson(Object payload) {
        if (payload == null) {
            return null;
        }
        try {
            return objectMapper.writeValueAsString(payload);
        } catch (JsonProcessingException e) {
            throw new IllegalArgumentException("Unable to serialize " + payload.getClass().getName(), e);
        }
    }

    private Message<String> outgoingMessage(Object payload, Map<String, Object> headers) {
        RecordHeaders recordHeaders = new RecordHeaders();
        String key = null;
        if (payload != null && (headers == null || !headers.containsKey(TYPE_ID_HEADER))) {
            recordHeaders.add(TYPE_ID_HEADER, payload.getClass().getName().getBytes(StandardCharsets.UTF_8));
        }
        if (headers != null) {
            for (Map.Entry<String, Object> entry : headers.entrySet()) {
                if (entry.getValue() == null) {
                    continue;
                }
                if ("kafka_messageKey".equals(entry.getKey())) {
                    key = String.valueOf(entry.getValue());
                    continue;
                }
                recordHeaders.add(entry.getKey(), String.valueOf(entry.getValue()).getBytes(StandardCharsets.UTF_8));
            }
        }
        OutgoingKafkaRecordMetadata<String> metadata = OutgoingKafkaRecordMetadata.<String>builder()
                .withKey(key)
                .withHeaders(recordHeaders)
                .build();
        return Message.of(toJson(payload)).addMetadata(metadata);
    }

    private boolean sendMessage(Emitter<String> emitter, Object payload, Map<String, Object> headers, int timeout) {
        Message<String> message = outgoingMessage(payload, headers);
        TransactionSynchronizationRegistry transaction = activeTransaction();
        if (transaction != null) {
            transaction.registerInterposedSynchronization(new Synchronization() {
                @Override
                public void beforeCompletion() {}

                @Override
                public void afterCompletion(int status) {
                    if (status == Status.STATUS_COMMITTED) {
                        sendAfterCommit(emitter, message);
                    } else {
                        log.debug("Transaction not committed, message discarded");
                    }
                }
            });
            return true;
        }
        return sendAndWait(emitter, message, timeout);
    }

    private TransactionSynchronizationRegistry activeTransaction() {
        if (transactionRegistry.isResolvable()) {
            TransactionSynchronizationRegistry registry = transactionRegistry.get();
            if (registry.getTransactionStatus() == Status.STATUS_ACTIVE) {
                return registry;
            }
        }
        return null;
    }

    private void sendAfterCommit(Emitter<String> emitter, Message<String> message) {
        try {
            emitter.send(message.withNack(reason -> {
                log.error("Failed to send message after commit: {}", reason.getMessage(), reason);
                return CompletableFuture.completedFuture(null);
            }));
        } catch (RuntimeException e) {
            log.error("Failed to send message after commit: {}", e.getMessage(), e);
        }
    }

    private boolean sendAndWait(Emitter<String> emitter, Message<String> message, int timeout) {
        CompletableFuture<Void> acknowledged = new CompletableFuture<>();
        Message<String> tracked = message
                .withAck(() -> {
                    acknowledged.complete(null);
                    return CompletableFuture.completedFuture(null);
                })
                .withNack(reason -> {
                    acknowledged.completeExceptionally(reason);
                    return CompletableFuture.completedFuture(null);
                });
        try {
            emitter.send(tracked);
            acknowledged.get(timeout, TimeUnit.SECONDS);
            return true;
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            log.error("Message sending interrupted", e);
            return false;
        } catch (TimeoutException | ExecutionException e) {
            Throwable cause = (e instanceof ExecutionException) ? e.getCause() : e;
            log.error("Failed to send message: {}", cause.getMessage(), cause);
            throw new RuntimeException("Failed to send message", cause);
        }
    }

