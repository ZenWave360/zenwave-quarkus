<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.zenwave360.sdk</groupId>
        <artifactId>zenwave-quarkus</artifactId>
        <version>2.9.0-SNAPSHOT</version>
    </parent>
    <name>${project.groupId}:${project.artifactId}</name>
    <artifactId>e2e</artifactId>
    <packaging>jar</packaging>

    <properties>
        <e2e.tests.skip>true</e2e.tests.skip>
        <skipTests>${e2e.tests.skip}</skipTests>
        <git-publisher.skip>true</git-publisher.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.zenwave360.sdk</groupId>
            <artifactId>zenwave-sdk-cli</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk</groupId>
            <artifactId>zenwave-sdk-test-resources</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk</groupId>
            <artifactId>test-resources</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk.plugins</groupId>
            <artifactId>backend-application-default</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk.plugins</groupId>
            <artifactId>openapi-controllers</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk.plugins</groupId>
            <artifactId>openapi-spring-webtestclient</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk.plugins</groupId>
            <artifactId>asyncapi-generator</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk.plugins</groupId>
            <artifactId>zdl-to-openapi</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk.plugins</groupId>
            <artifactId>zdl-to-asyncapi</artifactId>
            <version>${zenwave-sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk</groupId>
            <artifactId>quarkus-backend-application</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zenwave360.sdk</groupId>
            <artifactId>asyncapi-quarkus</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- projects/ are read from src/ by ScaffoldProject, never from the classpath -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <excludes>
                    <exclude>projects/**</exclude>
                </excludes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${surefire.argLine}</argLine>
                    <systemPropertyVariables>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
